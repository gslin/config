#
if ! whence compinit >/dev/null; then
  autoload -Uz compinit && compinit
  compinit
fi
[[ -s /usr/share/doc/fzf/examples/completion.zsh ]] && source /usr/share/doc/fzf/examples/completion.zsh
[[ -s /usr/share/doc/fzf/examples/key-bindings.zsh ]] && source /usr/share/doc/fzf/examples/key-bindings.zsh
#
alias cc0="claude-bwrap \$(which claude) --dangerously-skip-permissions"
alias cc1="CLAUDE_CONFIG_DIR=~/.claude-c1 claude-bwrap --setenv CLAUDE_CONFIG_DIR ~/.claude-c1 \$(which claude) --dangerously-skip-permissions"
alias cx0="codex-bwrap \$(which codex) --yolo"
alias gb0="grok-bwrap \$(which grok) --yolo"
alias oc0="opencode-bwrap \$(which opencode)"
alias update="(cd ~/git; make all)"
#
if command -v mise > /dev/null; then
    eval "$(mise activate zsh)"
fi
#
if command -v sdcv > /dev/null; then
    alias de="sdcv"
fi
#
# Composer
if [[ -e "${HOME}/.config/composer/vendor/bin" ]]; then
    export PATH="${HOME}/.config/composer/vendor/bin:${PATH}"
fi
